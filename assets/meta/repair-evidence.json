    {
      "change": "Use the extracted original Ready shader for the half-second warning phase, below notes; retain material 11 (shine speed 37.9, brightness .12)",
      "source": "https://github.com/CHCAT1320/CHCAT-Docs/blob/054fcfdddc4ddf66b1bbecc45df0d5264e3d3852/knowladge/phigros/shaders/Unlit_ReadyBlock.md",
      "adaptation": "GLES 3 to WebGL 1 syntax only; original arithmetic retained; ready geometry remains in combined disabled masks according to original camera culling masks 40960/81920"
    },
    {
      "change": "Restore original pause PNG with a persistent data URL for CSS",
      "basis": "The existing imageFromBlob revokes the temporary blob URL after decoding; CSS background causes another image request and was using that revoked address. Original pause pixels, geometry and pointer handler retained."
    },
    {
      "change": "Unify input velocity timestamps, ignore stale or duplicate motion samples, and prevent pointer recovery from acquiring UI/outside contacts",
      "basis": "W3C Pointer Events chronological coalesced-sample requirement and inspection of mixed timestamp code paths. Existing native contact recovery, real-up release and noise latch preserved.",
      "source": "https://www.w3.org/TR/pointerevents/"
    },
    {
      "change": "Correct persistent visual-clock drift and display-specific missed-vblank diagnostics",
      "basis": "The previous prediction retained errors below 50 ms indefinitely. Proportional correction converges while interpolating audio quanta; note timing and input judgement remain on the audio clock. Missed frames use measured cadence, not a fixed 120 Hz threshold."
    },
    {
      "change": "Fix PJSK asymmetric flick/tail windows, require captured down for normal flicks, and defer early Trace to target time",
      "source": "https://github.com/Next-SEKAI/sonolus-next-sekai-engine/tree/d3a3cef0888e95dc01ab0dddaa1eb6ebc2aa8fe3",
